# =====================================================================
# App MVF — variáveis de ambiente (copie para .env.local e preencha).
# NUNCA commite valores reais. Somente NEXT_PUBLIC_* chega ao navegador.
# =====================================================================

# --- Supabase (Project Settings → API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_…). Segura no navegador: tudo passa pela RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVICE ROLE / secret key: ignora RLS. Só servidor e CLI. Jamais NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada no link mágico). Em produção: https://app.seudominio.com.br
APP_BASE_URL=http://localhost:3000

# Link opcional exibido em "Acesso indisponível" (ex.: página de suporte/WhatsApp oficial).
MVF_SUPPORT_CONTACT_URL=

# Prévia dos módulos (dados de EXEMPLO, sempre rotulados) para contas reais de teste.
# Vazio = ninguém. "all" = todas as alunas com acesso. Ou e-mails separados por vírgula.
# Não dá acesso a nada: só troca o "Em breve" pelas telas de demonstração.
MVF_PREVIEW_MODULES=

# --- Kiwify (Apps → API) ------------------------------------------------
# Credenciais OAuth da API pública (POST /oauth/token com client_id + client_secret).
KIWIFY_ACCOUNT_ID=
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
# Token do webhook (Apps → Webhooks). Usado para validar a assinatura HMAC-SHA1.
KIWIFY_WEBHOOK_TOKEN=
# Durante rotação de token: o anterior, por ~24 h. Depois, deixe vazio.
KIWIFY_WEBHOOK_TOKEN_PREVIOUS=
# IDs REAIS dos produtos MVF que dão acesso, separados por vírgula.
# Vazio = nenhum acesso é liberado (falha fechada). Não inclua upsells/order bumps/cosméticos.
KIWIFY_ALLOWED_PRODUCT_IDS=

# --- Desenvolvimento ------------------------------------------------------
# true SOMENTE para testar layout/motor com `npm run dev` sem Supabase.
# Ignorado fora de NODE_ENV=development (produção nunca abre por esta flag).
MVF_DEMO_MODE=false

# Painel administrativo DEMONSTRATIVO (/gestao). Só vale junto com MVF_DEMO_MODE=true
# em `npm run dev`. NUNCA ligar em homologação/produção (o servidor nega e o preflight acusa).
MVF_ADMIN_DEMO=false

# --- Assistente MVF (suporte com IA) — docs/SUPORTE_IA.md ----------------
# Desligado por padrão. Só ligar DEPOIS da migration do suporte aplicada com autorização.
# A chave NUNCA vai para variável NEXT_PUBLIC_ nem para o navegador.
MVF_SUPPORT_AI_ENABLED=false
# memory (demonstração local) | supabase (conversas no banco; exige a migration 20261126120000_suporte_ia.sql)
MVF_SUPPORT_STORE=memory
DEEPSEEK_API_KEY=
# Modelo conferido na documentação oficial em 26/11/2026.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Limites (o banco aplica os seus próprios em public.support_settings).
MVF_SUPPORT_MAX_MESSAGES=30
MVF_SUPPORT_DAILY_LIMIT=60
MVF_SUPPORT_MAX_TOKENS=600
MVF_SUPPORT_TIMEOUT_MS=25000
# Vazio = desligado. Encerramento por inatividade exige job de servidor (ver docs).
MVF_SUPPORT_INACTIVITY_MINUTES=
# Vazio = política de retenção ainda não aprovada (nada é apagado).
MVF_SUPPORT_RETENTION_DAYS=
